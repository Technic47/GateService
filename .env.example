# Скопировать в .env и заполнить. Файл .env в git не попадает (см. .gitignore).

# ---------- База данных ----------
# Приложение подключается к primary. Standby нужен для disaster recovery,
# читающие запросы туда не направляются (см. CLAUDE.md).
GATE_DB_HOST=144.31.187.7
GATE_DB_PORT=5432
GATE_DB_NAME=gate
GATE_DB_USER=gate
GATE_DB_PASSWORD=

# ---------- Секреты ----------
# Ключ подписи remember-me. Должен быть постоянным между перезапусками:
# сгенерировать один раз через `openssl rand -base64 32` и больше не менять.
# Смена ключа разлогинивает всех, у кого стоит «запомнить меня».
GATE_REMEMBER_ME_KEY=

# Пароль администратора при первом старте. Если оставить пустым, при создании
# администратора сгенерируется случайный и один раз напечатается в лог.
# Используется только когда в базе ещё нет ни одного админа.
GATE_ADMIN_USERNAME=admin
GATE_ADMIN_PASSWORD=

# ---------- Сеть ----------
GATE_PORT=9000
# 127.0.0.1 для запуска на хосте; в контейнере compose ставит 0.0.0.0.
GATE_BIND_ADDRESS=127.0.0.1

# Cookie сессии только по HTTPS. Ставить false можно исключительно
# для локальной отладки по http — иначе сессия уйдёт открытым текстом.
GATE_COOKIE_SECURE=true

# ---------- Gate Auth (общий стандарт авторизации, ../gate-auth) ----------
# Ключ подписи токенов для приложений: приватный JWK Ed25519 одной строкой.
# Сгенерировать (в ../gate-auth после mvn install):
#   java -cp gate-auth-core/target/gate-auth-core-0.1.0.jar io.github.technic47.gateauth.core.KeyTool
# Сюда — строку из блока PRIVATE JWK. Публичный ключ (PEM) — в конфиг приложений.
# Пусто — токены не выдаются: X-Gate-Assertion и вход из LAN (/auth/handoff) выключены.
# Смена ключа = смена публичного ключа во всех приложениях (порядок ротации — §3 спецификации).
GATE_SIGNING_KEY=
# Либо путь к файлу с тем же JWK (на машине, где крутится контейнер, не на рабочей).
GATE_SIGNING_KEY_FILE=

# Создавать ли сервис fashionmark при пустой базе.
GATE_SEED_DEFAULT_SERVICE=true
